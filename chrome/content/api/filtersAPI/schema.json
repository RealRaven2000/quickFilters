[
  {
    "namespace": "FiltersAPI",
    "description": "Experimental API for filter discovery, backup, restore and review.",
    "functions": [
      {
        "name": "convertFilterToApi",
        "type": "function",
        "description": "Convert a Thunderbird filter to a tuple containing account URI and filter name.",
        "parameters": [
          {
            "name": "filter",
            "type": "object",
            "description": "The native Thunderbird filter object (privileged only)."
          }
        ],
        "returns": {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string"
            },
            "filterName": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "convertFilterFromApi",
        "type": "function",
        "description": "Finds and returns a Thunderbird filter from a given account/name combo.",
        "parameters": [
          {
            "name": "filterTuple",
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string"
              },
              "filterName": {
                "type": "string"
              }
            },
            "required": [
              "accountId",
              "filterName"
            ]
          }
        ],
        "returns": {
          "type": "any",
          "description": "The matched nsIMsgFilter object, or a proxy reference if needed."
        }
      },
      {
        "name": "getFilters",
        "type": "function",
        "description": "Retrieves an array of filters (filter names?)",
        "async": true,
        "parameters": [
          {
            "name": "sourceUri",
            "type": "string",
            "description": "folder URI to find account where filters are stored (applied inbox)"
          },
          {
            "name": "targetUri",
            "type": "string",
            "optional": true,
            "description": "folder URI targeted by filters (move / copy to). omit to list all filters for thge account"
          },
          {
            "name": "filterAction",
            "type": "number",
            "optional": true,
            "description": "Optional: filter action type to match (e.g., MoveToFolder, Delete, AddTag, Custom)"
          },
          {
            "name": "filterActionExt",
            "type": "string",
            "optional": true,
            "description": "Optional: extended filter action info (e.g., tag name for AddTag, customId for Custom actions)"
          }
        ],
        "returns": {
          "type": "any",
          "description": "Array of filter objects, each containing filterName, accountId, type, templateName (if applicable), description, enabled, matchedActionType, and matchedActionExt"
        }
      },
