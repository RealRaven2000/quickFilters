          }
        ]
      },

      {
        "name": "getApplyIncomingFilters",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "folderURI",
            "type": "string",
            "description": "The URI of the IMAP folder"
          }
        ]
      },

      {
        "name": "getApiMessageId",
        "type": "function",
        "async": true,
        "description": "Retrieve the API messageId for a given folderURI and messageID.",
        "parameters": [
          {
            "name": "folderURI",
            "type": "string",
            "description": "The URI of the folder containing the message"
          },
          {
            "name": "messageID",
            "type": "string",
            "description": "The message ID of the message to look up"
          }
        ],
        "returns": {
          "type": "string",
          "description": "The API messageId or null if not found"
        }
      },

      {
        "name": "resolveAssistant",
        "type": "function",
        "async": true,
        "description": "Send back assistant result from HTML assistant",
        "parameters": [
          {
            "name": "requestId",
            "type": "string"
          },
          {
            "name": "result",
            "type": "string",
            "enum": ["merge", "success", "cancelled"]
          },
          {
            "name": "params",
            "type": "object",
            "properties": {
              "answer": { "type": "boolean" },
              "selectedMergedFilterIndex": { "type": "integer" }
            },
            "required": ["answer"],
            "additionalProperties": true
          }
        ],
        "returns": {
          "type": "boolean",
          "description": "whether promise was found + resolved"
        }
      },

