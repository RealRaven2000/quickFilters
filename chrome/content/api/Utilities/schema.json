      {
        "name": "getFolderUri",
        "type": "function",
        "async": true,
        "description": "returns legacy URI for a folder / account",
        "parameters": [
          {
            "name": "accountId",
            "type": "string",
            "description": "account key"
          },
          {
            "name": "path",
            "type": "string",
            "optional": true,
            "description": "path of the API folder"
          }
        ]
      },

      {
        "name": "setApplyIncomingFilters",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "folderURI",
            "type": "string",
            "description": "The URI of the IMAP folder"
          },
          {
            "name": "enabled",
            "type": "boolean",
