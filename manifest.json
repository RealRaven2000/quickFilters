{
  "manifest_version": 2,
  "name": "quickFilters",
  "description": "__MSG_extensionDescription__",
  "version": "6.13.2pre24",
  "default_locale": "en",
  "author": "Axel Grude",
  "developer": {
    "name": "Axel Grude",
    "url": "https://quickfilters.quickfolders.org/index.html"
  },
  "applications": {
    "gecko": {
      "id": "quickFilters@axelg.com",
      "strict_min_version": "140.0",
      "strict_max_version": "154.*"
    }
  },
  "background": {
    "page": "qFi-background.html"
  },
  "permissions": ["accountsRead", "clipboardRead", "notifications", "menus", "messagesRead", "storage", "tabs"],
  "browser_action": {
    "default_icon": {
      "19": "chrome/content/skin/QuickFilters.svg"
    },
    "default_title": "quickFilters",
    "default_popup": "chrome/content/quickfilters_main_popup.html",
    "allowed_spaces": ["mail"]
  },
  "commands": {
    "create-filter-from-message": {
      "suggested_key": {
        "default": "Ctrl+Alt+R",
        "mac": "Command+Alt+R"
      },
      "description": "Create a filter from the selected message"
    }
  },
  "experiment_apis": {
    "WindowListener": {
      "schema": "chrome/content/api/WindowListener/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["WindowListener"]],
        "script": "chrome/content/api/WindowListener/implementation.js"
      }
    },
    "LegacyPrefs": {
      "schema": "chrome/content/api/LegacyPrefs/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["LegacyPrefs"]],
        "script": "chrome/content/api/LegacyPrefs/implementation.js"
      }
    },
    "NotifyTools": {
      "schema": "chrome/content/api/NotifyTools/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["NotifyTools"]],
        "script": "chrome/content/api/NotifyTools/implementation.js",
        "events": ["startup"]
      }
    },
    "FiltersAPI": {
      "schema": "chrome/content/api/FiltersAPI/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["FiltersAPI"]],
        "script": "chrome/content/api/FiltersAPI/implementation.js"
      }
    },
    "Utilities": {
      "schema": "chrome/content/api/Utilities/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["Utilities"]],
        "script": "chrome/content/api/Utilities/implementation.js"
      }
    }
  },

  "icons": {
    "32": "chrome/content/skin/QuickFilters_32.svg",
    "64": "chrome/content/skin/QuickFilters_32.svg"
  },
  "options_ui": {
    "page": "html/quickfilters-settings.html",
    "open_in_tab": true
  }
}
